{
  "name": "@rin/ai-router",
  "version": "0.1.0",
  "description": "Provider-neutral AI Router implementing the locked routing spine: intake, context, classification, memory relevance, reasoning strategy, agent coordination, permission, and unified response.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rin/types": "workspace:*"
  },
  "devDependencies": {
    "@rin/memory": "workspace:*",
    "@rin/security": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
