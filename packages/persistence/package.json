{
  "name": "@rin/persistence",
  "version": "0.1.0",
  "description": "SQLite persistence layer for the RIN ecosystem: node:sqlite connection lifecycle, versioned forward migrations, and repository implementations for the approved Phase 5 entity subset (AuditLog, RuntimeConfiguration).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@rin/security": "workspace:*",
    "@rin/types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
